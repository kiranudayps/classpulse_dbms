{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "pages/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/(.*)", "dest": "/api/index.js" },
    { "src": "^/js/(.*)", "dest": "/js/$1" },
    { "src": "^/pages/(.*)", "dest": "/pages/$1" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/(.*)", "dest": "/$1" }
  ]
}
